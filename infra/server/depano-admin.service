[Unit]
Description=DEPANO back-office (Next.js)
After=network-online.target depano-api.service

[Service]
User=ubuntu
WorkingDirectory=/opt/depano/apps/admin
Environment=NODE_ENV=production
Environment=API_URL=http://127.0.0.1:3000
Environment=PORT=3001
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
