# --- Base ---
NODE_ENV=development
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
# --- Postgres + PostGIS / Redis (docker compose: pnpm infra:up) ---
DATABASE_URL=postgres://depano:depano@localhost:5432/depano
REDIS_URL=redis://localhost:6379
# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
OTP_PEPPER=change-me-pepper
# En dev, les OTP SMS sont loggés dans la console de l'API (SMS_PROVIDER=console)
SMS_PROVIDER=console
APPLE_CLIENT_ID=fr.depano.app
GOOGLE_CLIENT_ID=
# --- Stockage objet S3 (MinIO en local) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=fr-par
S3_BUCKET=depano-private
S3_ACCESS_KEY=depano
S3_SECRET_KEY=depano-secret
# --- Stripe Connect (PAYMENT_PROVIDER=fake pour développer sans Stripe) ---
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# --- Twilio (SMS OTP + relais d'appel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PROXY_SERVICE_SID=
# --- Push (PUSH_PROVIDER=console | expo) ---
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=
# --- Cartes ---
MAPBOX_PUBLIC_TOKEN=
# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000
# --- Admin (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3000
# --- Optionnels ---
# Clé AES-256 du code de fin (sinon dérivée de JWT_REFRESH_SECRET)
DATA_ENCRYPTION_KEY=
# Passkeys
WEBAUTHN_RP_ID=depano.fr
WEBAUTHN_ORIGINS=https://depano.fr
# URL S3 vue par le téléphone pour les URL signées (ex. http://192.168.1.10:9000 sur appareil réel)
S3_PUBLIC_ENDPOINT=
# true : aucun appel aux API publiques (adresse, SIRET)
OFFLINE_MODE=false
