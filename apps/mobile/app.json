{
  "expo": {
    "name": "DEPANO",
    "slug": "depano",
    "scheme": "depano",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FCFAF7",
    "ios": {
      "bundleIdentifier": "fr.depano.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DEPANO utilise votre position pour trouver les artisans proches et les guider jusqu'à vous.",
        "NSCameraUsageDescription": "DEPANO utilise l'appareil photo pour joindre une photo de la panne ou du chantier.",
        "NSPhotoLibraryUsageDescription": "DEPANO accède à vos photos pour joindre une image de la panne.",
        "NSMicrophoneUsageDescription": "DEPANO utilise le micro pour enregistrer des messages vocaux."
      }
    },
    "android": {
      "package": "fr.depano.app",
      "adaptiveIcon": {
        "backgroundColor": "#F1E4D3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "depano"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "DEPANO utilise le micro pour enregistrer des messages vocaux."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1E4D3",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#16120E",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DEPANO utilise votre position pour trouver les artisans proches et les guider jusqu'à vous."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DEPANO accède à vos photos pour joindre une image de la panne.",
          "cameraPermission": "DEPANO utilise l'appareil photo pour joindre une photo de la panne ou du chantier."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8A6A4A"
        }
      ],
      "expo-asset",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.fr.depano.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "DEPANO ajoute vos rendez-vous à votre calendrier si vous le demandez."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {}
    }
  }
}
