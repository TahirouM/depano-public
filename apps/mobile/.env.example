# URL de l'API DEPANO (sans /v1). Sur appareil physique, « localhost » est remplacé
# automatiquement par l'IP du serveur Metro ; sur émulateur Android par 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Connexion Google (optionnelle) : le bouton n'apparaît que si ces identifiants sont fournis.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
